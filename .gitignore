# macOS / Xcode per-user noise. `xcuserdata` holds window and breakpoint state that
# changes whenever the project is merely open, so it shows up as an untracked file
# in every session and never carries anything worth committing.
.DS_Store
**/xcuserdata/

# Pre-run MAL list entries recorded by scripts/mal_live_write.py. These are the only
# record of what the real account looked like before a live write, so they are kept on
# disk but never committed.
.mal-live-write/

# Container backups taken by scripts/seed-simulator.sh before it re-seeds.
.simulator-backups/
